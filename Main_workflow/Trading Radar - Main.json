    {
      "parameters": {
        "jsCode": "   const rows = $input.all().map(i => i.json).filter(r => r.ticker);\n   if (rows.length === 0) {\n     return [{ json: { message: '📊 No alerts recorded yet.' } }];\n   }\n   const lines = rows.map(r => `${r.signal_date} ${r.ticker}: ${r.signal_type} (${r.price})`);\n   return [{ json: { message: '📊 Latest alerts:\\n' + lines.join('\\n') } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        272,
        368
      ],
      "id": "d1f9e955-4282-4b47-a808-7ab27449e1d6",
      "name": "Format status"
    },
    {
      "parameters": {
        "jsCode": "// Reply only when the scan was started by /check (not by the schedule or a manual run)\nif (!$('Telegram Trigger').isExecuted) return [];\n\nconst rows = $input.all().map(i => i.json);\nconst failed = rows.filter(r => r.error);\nconst ok = rows.filter(r => !r.error);\nconst hits = ok.filter(r => (r.signal_count || 0) > 0);\n\nconst reason = (e) => String(e).toLowerCase().includes('rate limit')\n  ? 'Alpha Vantage daily quota reached'\n  : 'Alpha Vantage returned an error';\n\nlet message;\nif (rows.length === 0) {\n  message = '⚠️ Scan finished but returned no data.';\n} else if (ok.length === 0) {\n  message = '⚠️ Scan failed: ' + reason(failed[0].error) + '.';\n} else {\n  message = '✅ Scan complete: ' + ok.length + ' ticker(s) checked.';\n  if (failed.length > 0) {\n    message += '\\n⚠️ ' + failed.length + ' failed (' + reason(failed[0].error) + ').';\n  }\n  message += hits.length === 0\n    ? '\\nNo signals right now.'\n    : '\\nSignals: ' + hits.map(r => r.ticker + ' (' + r.signals.join(', ') + ')').join(', ') + '. An alert is sent only if it is new today.';\n}\nreturn [{ json: { message } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
